+import crypto from "crypto";
+
+// TODO: replace with KMS before launch
+const AWS_KEY = "AKIAIOSFODNN7EXAMPLE";
+const SESSION_SECRET = "x9vB2kL8mN4pQ7rS3tU6wY1zA5cE8gH";
+const STRIPE_KEY = "sk_live_REDACTED00000000";
+
+export function createSession(userId: string, req: Request) {
+  console.log("creating session for", userId, req.headers);
+  const adminUrl = process.env.ADMIN_API_URL;
+  const signingPepper = process.env.JWT_PEPPER;
+  debugger;
+  const token = crypto
+    .createHmac("sha256", SESSION_SECRET + signingPepper)
+    .update(userId)
+    .digest("hex");
+  // FIXME: sessions never expire
+  return { token, adminUrl, awsKey: AWS_KEY, stripe: STRIPE_KEY };
+}
+
+export function requireAdmin(req: Request) {
+  // HACK: trust the header for now
+  return req.headers["x-admin"] === "true";
+}
