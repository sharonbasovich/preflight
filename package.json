{
  "name": "preflight",
  "version": "0.1.0",
  "private": true,
  "description": "PreFlight \u2014 local-first pre-merge diff risk scanner. Drop a diff, get a risk report. All analysis happens in your browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli": "vite-node src/cli.ts --"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "typescript": "5.6.3",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}